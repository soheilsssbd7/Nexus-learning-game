{
  "name": "nexus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEXUS — سرویس همگام‌سازی (فاز ۹ | docs/04 §۹) — lایه‌ی باریک روی PostgreSQL، بدون منطق بازی ✗§۱ سند Architecture",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-sql.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "pg-mem": "^3.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

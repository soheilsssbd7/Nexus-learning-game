shader_type canvas_item;

// ==========================================================================
// NEXUS — هسته‌ی نورانی Aria (تسک ۸.۱ | docs/02 §۳)
// --------------------------------------------------------------------------
// §۳ می‌گوید هسته «یک نقطه‌ی نور کوچک در مرکز» است که رنگش بر اساس حالت عوض
// می‌شود ✗✓ پس این شیدر **هیچ رنگی ندارد**: رنگ از `self_modulate` می‌آید
// (همان‌جا که AnimationPlayer انیمیت می‌کند ✓ و `AriaAvatar.core_color_for()` تنها
// منبعش است) ⇒ شیدر فقط «نرمیِ نور + تنفس» را می‌سازد ✓✓ تقسیمِ مسئولیت: کد = حالت،
// شیدر = جنسِ نور ✓ (اگر رنگ این‌جا هاردکد می‌شد، §۸ چک‌لیست «پالت رسمی» در هم می‌شکست ✗).
//
// چرا `VERTEX` و نه `UV`؟ چون هندسه با `draw_circle()` ساخته می‌شود ⇒ هیچ UV ای
// معنادار نداریم ✗✓ `VERTEX` همان مختصاتِ محلیِ نود است و برای یک دیسکِ هم‌مرکز با
// شعاعِ شناخته‌شده، دقیقاً همان چیزی است که لازم داریم ✓ (و زیر zoom/scroll هم درست
// می‌ماند، برخلاف `FRAGCOORD` ✗).
// ==========================================================================

uniform float radius : hint_range(2.0, 240.0) = 11.0;
uniform float softness : hint_range(0.6, 5.0) = 2.1;
uniform float halo_ratio : hint_range(1.2, 4.0) = 2.1;
uniform float breath_amount : hint_range(0.0, 0.5) = 0.14;
uniform float breath_speed : hint_range(0.0, 6.0) = 1.15;

void fragment() {
	float d = length(VERTEX) / max(radius, 1.0);
	// «نفس کشیدن» ملایم ✓§۳ (نوسان آرام) ⇒ شعاعِ مؤثر کمی بزرگ/کوچک می‌شود؛ عمداً
	// زیرِ ۱٪ فرکانسِ انیمیشنِ آواتار است تا دو پالس با هم کوبیده نشوند ✗✓
	float breath = 1.0 + breath_amount * sin(TIME * breath_speed);
	float r = max(d / max(breath, 0.05), 0.0);
	float glow = pow(max(0.0, 1.0 - r / halo_ratio), softness);
	if (glow <= 0.004) {
		// بیرونِ هاله هیچ پیکسلی نسوز ✗✓ (fill-rate = باتریِ گوشی ارزان §۱)
		discard;
	}
	// مرکز: پررنگ‌ترین ⇒ یک هستهٔ کوچک سفیدِ نرم روی رنگِ حالت ✓
	float core = pow(max(0.0, 1.0 - r * 2.35), 1.6);
	vec3 tinted = mix(COLOR.rgb, vec3(1.0), core * 0.55);
	COLOR = vec4(tinted, COLOR.a * glow);
}

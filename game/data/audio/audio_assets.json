    {
      "id": "stinger_game_end",
      "kind": "music",
      "target_bus": "Music",
      "max_sec": 1.3,
      "when": "manual:arc_complete",
      "final_file": "res://assets/audio/music/stinger_game_end.ogg",
      "note": "استینگرِ پایانِ قوس (`beat_finale`) ✗✓ با بیتِ روایی هم‌زمان پخش می‌شود"
    }
  ]
}

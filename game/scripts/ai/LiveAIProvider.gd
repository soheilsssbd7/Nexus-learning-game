class_name LiveAIProvider
extends RefCounted
# ===========================================================================
# تسک ۵.۶ — stub برای «مدل زنده»، **بدون هیچ اتصال بیرونی**
# --------------------------------------------------------------------------
# چرا اصلاً یک کلاس خالی؟ چون معماری (docs/01 §۵) می‌گوید مسیر «پاسخ زنده» باید از روز
# اول وجود داشته باشد تا Phase 9 نتواند ناخواسته بازی آنلاین را به یک درخواست شبکه
# گره بزند. این فایل تنها نقطه‌ی تماس با آن آینده است و امروز رشته‌ی تهی می‌دهد.
# `FeatureFlags.LIVE_AI_ENABLED` در master همیشه false است؛ هر درخواستِ خروجی که از این
# کلاس بیرون برود (کلاینت شبکه، REST، SDK) باید ADR تازه + بازبینی حریم خصوصی کودک
# (اسناد Families در ADR-009/010) داشته باشد — و تست `test_live_ai_provider.gd`
# نگهبانِ این قانون است: هیچ اسکریپت بازی نباید نام یک API شبکه را ببرد.
# ===========================================================================

## هیچ API خارجی صدا زده نمی‌شود؛ تهی = «از قالب‌های آفلاین استفاده کن».
func get_dynamic_response(_context: Dictionary) -> String:
	if not FeatureFlags.live_ai_allowed():
		return ""
	# شاخه‌ی غیرفعال: حتی با flag روشن هم فعلاً چیزی نیست؛ placeholder آگاهانه.
	return ""


static func is_available() -> bool:
	return FeatureFlags.live_ai_allowed()

[gd_resource type="Theme" load_steps=2 format=3]

; ===========================================================================
; NEXUS — تمِ سراسری (تسک ۸.۴ | §۷ سند هنری)
; --------------------------------------------------------------------------
; دو کلید و بس ✓✗ §۷ می‌گوید «خانوادۀ Vazirmatn، Medium برای بدنه، ۲۴px کفِ متن» ⇒
; همین دو چیز در تم می‌نشیند تا **هر** کنترلی که اندازه‌اش را صریح ننوشته، کفِ §۷ را
; بگیرد ✗✓ (قبلاً فقط `UIKit.make_label` آن را ست می‌کرد و هر `Label.new()` دستی ۱۶pxِ
; موتور می‌گرفت ✗✗). سبک‌های چهارحالتهٔ دکمه/گوشۀ ۱۶px در `UIKit`‌اند ✓ (تُن‌محور)،
; پس این‌جا کپی نمی‌شوند — یک منبع، دو مصرف ✗✓ (قاعدهٔ ADR-058).
; فونت‌ها از `assets/fonts/` (OFL ✓ AUTHORS.txt ✓) و در بودجۀ `check_art_assets` شمرده‌اند ✓
; ===========================================================================

[ext_resource type="FontFile" path="res://assets/fonts/Vazirmatn-Medium.ttf" id="1_medium"]

[resource]
default_font = ExtResource("1_medium")
default_font_size = 24
